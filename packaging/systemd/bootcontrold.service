[Unit]
Description=BootControl privileged boot configuration daemon
Documentation=https://github.com/szymonpaczos/bootcontrol
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
ExecStart=/usr/bin/bootcontrold
User=root
Group=root
Restart=on-failure
RestartSec=1s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bootcontrold
BusName=org.bootcontrol.Manager

# Security constraints
ProtectSystem=full
ProtectHome=yes
RestrictNamespaces=yes
ReadWritePaths=-/boot
ReadWritePaths=-/etc/bootcontrol
ReadWritePaths=-/etc/default/grub
ReadWritePaths=-/etc/kernel
ReadWritePaths=-/var/lib/bootcontrol
