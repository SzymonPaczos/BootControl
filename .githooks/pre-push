#!/usr/bin/env bash
# Validate each pushed tip in an isolated checkout, never the working tree.
# Input is Git's <local-ref> <local-sha> <remote-ref> <remote-sha> protocol.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
STATUS=0
TEMP_ROOT=""
WORKTREE=""

cleanup() {
    if [ -n "$WORKTREE" ]; then
        git -C "$ROOT" worktree remove --force "$WORKTREE" || return 1
        WORKTREE=""
    fi
    if [ -n "$TEMP_ROOT" ]; then
        rmdir "$TEMP_ROOT" || return 1
        TEMP_ROOT=""
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

check_tip() (
    cd "$WORKTREE"
    # Hooks can inherit repository-local variables from Git. Do not let them
    # redirect commands in this checkout to the user's index or working tree.
    while IFS= read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)
    local audit_date audit_epoch age
    audit_date="$(sed -nE 's/^## Audyt ([0-9]{4}-[0-9]{2}-[0-9]{2}).*/\1/p' .claude/audit-log.md | sed -n '1p')" || return 1
    if [ -z "$audit_date" ]; then
        echo 'pre-push: missing audit date in pushed commit' >&2
        return 1
    fi
    audit_epoch="$(date -j -f '%Y-%m-%d' "$audit_date" +%s 2>/dev/null || date -d "$audit_date" +%s)" || return 1
    age=$(( ($(date +%s) - audit_epoch) / 86400 ))
    if [ "$age" -lt 0 ] || [ "$age" -gt 7 ]; then
        echo "pre-push: audit date $audit_date is outside the last seven days" >&2
        return 1
    fi
    if [ ! -x scripts/ci-local.sh ]; then
        echo 'pre-push: pushed commit has no executable scripts/ci-local.sh' >&2
        return 1
    fi
    # Reuse compiler artifacts, but run all checks against this checkout.
    export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target}"
    ./scripts/ci-local.sh
)

while read -r local_ref local_sha remote_ref remote_sha extra || [ -n "${local_ref:-}" ]; do
    if [ -n "${extra:-}" ] || [[ ! "${local_sha:-}" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] \
        || [[ ! "${remote_sha:-}" =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] \
        || [ -z "${local_ref:-}" ] || [ -z "${remote_ref:-}" ]; then
        echo 'pre-push: malformed ref update' >&2
        STATUS=1
        continue
    fi
    # Deletions introduce no files and need no checkout or CI invocation.
    if [[ "$local_sha" =~ ^0+$ ]]; then continue; fi
    if ! git -C "$ROOT" cat-file -e "$local_sha^{commit}"; then
        STATUS=1
        continue
    fi
    if [[ "$remote_sha" =~ ^0+$ ]]; then
        range="$(git -C "$ROOT" rev-list "$local_sha" --not --remotes)" || { STATUS=1; continue; }
    else
        range="$(git -C "$ROOT" rev-list "$remote_sha..$local_sha")" || { STATUS=1; continue; }
    fi
    export BOOTCONTROL_PUSH_COMMITS="$range"
    TEMP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/bootcontrol-pre-push.XXXXXXXX")" || exit 1
    WORKTREE="$TEMP_ROOT/checkout"
    if ! git -C "$ROOT" worktree add --detach "$WORKTREE" "$local_sha"; then
        STATUS=1
        # A failed add may still leave a registered checkout; cleanup handles it.
        if [ ! -e "$WORKTREE/.git" ]; then WORKTREE=""; fi
        cleanup || exit 1
        continue
    fi
    echo "pre-push: checking $local_ref ($local_sha) -> $remote_ref"
    if ! check_tip; then STATUS=1; fi
    cleanup || exit 1
done
exit "$STATUS"
