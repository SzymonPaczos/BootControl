// crates/gui/ui/pages/secure_boot.slint
//
// Secure Boot status + actions. Stacja (Faza C §3.4): explanatory banner,
// a State group of status rows and a "What you can do" group with the
// actions next to their descriptions — actions moved OUT of the page
// header (too easy to hit by accident). NOTE: both actions still call the
// direct callbacks; routing them through the Confirmation Sheet is the
// open backlog P1 (together with the empty-path fix) — visual layer only
// here.

import { Tokens } from "../tokens.slint";
import { GhostButton } from "../components/ghost_button.slint";
import { InfoBar } from "../components/info_bar.slint";
import { Group, GroupLabel, RowSeparator, SettingRow, StatusPill } from "../components/row_group.slint";

export component SecureBootPage inherits Rectangle {
    in property <string> active-backend;
    in property <string> secure-boot-status: "Unknown";
    in property <string> mok-status: "Unknown";
    in property <bool> show-loading;
    callback backup-nvram();
    callback enroll-mok();

    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        spacing: Tokens.group-gap;
        alignment: start;

        if root.secure-boot-status == "Disabled" : InfoBar {
            severity: "warning";
            message: "Secure Boot is disabled — the system will boot any kernel image. Enabling it requires entering the firmware setup; BootControl cannot do that for you.";
        }

        VerticalLayout {
            spacing: Tokens.group-label-gap;
            GroupLabel { text: "State"; }
            Group {
                SettingRow {
                    icon: root.secure-boot-status == "Enabled"
                        ? @image-url("../../assets/icons/gpp-good-fill.svg")
                        : @image-url("../../assets/icons/gpp-bad-fill.svg");
                    icon-color: root.secure-boot-status == "Enabled" ? Tokens.success
                        : (root.secure-boot-status == "Disabled" ? Tokens.error : Tokens.on-surface-faint);
                    title: "Secure Boot";
                    description: root.secure-boot-status == "Enabled"
                        ? "Firmware verifies every boot image"
                        : (root.secure-boot-status == "Disabled"
                            ? "The system will boot any kernel image"
                            : "State could not be determined");
                    StatusPill {
                        text: root.secure-boot-status;
                        dot-color: root.secure-boot-status == "Enabled" ? Tokens.success
                            : (root.secure-boot-status == "Disabled" ? Tokens.error : Tokens.on-surface-faint);
                    }
                }
                RowSeparator {}
                SettingRow {
                    icon: @image-url("../../assets/icons/key.svg");
                    title: "MOK key";
                    description: "Machine Owner Key enrolled in firmware";
                    StatusPill {
                        text: root.mok-status;
                        dot-color: root.mok-status == "Yes" ? Tokens.success
                            : (root.mok-status == "No" ? Tokens.error : Tokens.on-surface-faint);
                    }
                }
                RowSeparator {}
                SettingRow {
                    icon: @image-url("../../assets/icons/memory.svg");
                    icon-color: Tokens.accent-info;
                    title: "Active backend";
                    description: "Bootloader currently managed by BootControl";
                    StatusPill {
                        text: root.active-backend;
                        dot-color: Tokens.accent-info;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Tokens.group-label-gap;
            GroupLabel { text: "What you can do"; }
            Group {
                SettingRow {
                    icon: @image-url("../../assets/icons/key.svg");
                    title: "Enroll MOK key";
                    description: "Signs the UKI image and registers the key for the next reboot";
                    GhostButton {
                        text: "Enroll MOK";
                        width: 130px;
                        height: Tokens.button-height-sm;
                        enabled: !root.show-loading;
                        clicked => { root.enroll-mok(); }
                    }
                }
                RowSeparator {}
                SettingRow {
                    icon: @image-url("../../assets/icons/save.svg");
                    title: "Back up NVRAM";
                    description: "Saves all EFI Secure Boot variables to /var/lib/bootcontrol/certs/";
                    GhostButton {
                        text: "Back up";
                        width: 110px;
                        height: Tokens.button-height-sm;
                        enabled: !root.show-loading;
                        clicked => { root.backup-nvram(); }
                    }
                }
            }
        }
    }
}
