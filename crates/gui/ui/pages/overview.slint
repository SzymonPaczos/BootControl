// crates/gui/ui/pages/overview.slint
//
// At-a-glance live status of the boot stack. Stacja (Faza C §3.1):
// three row groups — System state / Boot configuration / Recent activity —
// replace the hero card + tile row. Every value row is a SettingRow on an
// explicit column grid; technical values render in the mono face.
// The config etag moved off this page (Cut, Faza C §3.1) — it lives in the
// Confirmation Sheet and, post-Tor-A, in Bootloader → Advanced.

import { Tokens } from "../tokens.slint";
import { SectionHeader } from "../components/section_header.slint";
import { InfoBar } from "../components/info_bar.slint";
import { OnboardingCard } from "../components/onboarding_card.slint";
import { GhostButton } from "../components/ghost_button.slint";
import { AuditLogLink } from "../components/audit_log_link.slint";
import { Group, GroupLabel, RowSeparator, SettingRow, StatusPill } from "../components/row_group.slint";
import { LogRow } from "logs.slint";

export component OverviewPage inherits Rectangle {
    in property <string> active-backend;
    in property <string> grub-default-entry: "—";
    in property <int> grub-timeout: 0;
    in property <string> grub-config-path: "—";
    in property <string> grub-config-etag: "—";

    in property <string> secure-boot-status: "Unknown";
    in property <bool> setup-mode-active: false;
    in property <int> mok-count: 0;
    in property <int> snapshot-count: 0;
    in property <string> last-snapshot-ts: "—";

    in property <[LogRow]> recent-activity: [];

    in property <bool> show-onboarding: false;

    callback open-bootloader-page();
    callback open-secure-boot-page();
    callback open-snapshots-page();
    callback open-logs-page();
    callback open-audit-log(string);
    callback start-with-boot-entries();
    callback learn-more();
    callback never-show-onboarding();

    vertical-stretch: 1;
    background: transparent;

    Flickable {
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            spacing: Tokens.group-gap;
            alignment: start;

            // Setup Mode warning (top-page, Q2 verdict)
            if root.setup-mode-active : InfoBar {
                severity: "warning";
                message: "Secure Boot is in Setup Mode — any signed binary can be enrolled.";
                dismissible: false;
            }

            // Onboarding card (first-launch only)
            if root.show-onboarding : OnboardingCard {
                active-backend: root.active-backend;
                start-with-boot-entries => { root.start-with-boot-entries(); }
                learn-more => { root.learn-more(); }
                never-show => { root.never-show-onboarding(); }
            }

            // ── System state ─────────────────────────────────────────────
            VerticalLayout {
                spacing: Tokens.group-label-gap;
                GroupLabel { text: "System state"; }
                Group {
                    SettingRow {
                        icon: @image-url("../../assets/icons/memory.svg");
                        icon-color: Tokens.accent-info;
                        title: "Bootloader";
                        description: root.active-backend + " · " + root.grub-config-path;
                        show-chevron: true;
                        hoverable: true;
                        clicked => { root.open-bootloader-page(); }
                        StatusPill {
                            text: root.active-backend;
                            dot-color: Tokens.accent-info;
                        }
                    }
                    RowSeparator {}
                    SettingRow {
                        icon: root.secure-boot-status == "Enabled"
                            ? @image-url("../../assets/icons/gpp-good-fill.svg")
                            : @image-url("../../assets/icons/gpp-bad-fill.svg");
                        icon-color: root.secure-boot-status == "Enabled" ? Tokens.success
                            : (root.secure-boot-status == "Disabled" ? Tokens.error : Tokens.on-surface-faint);
                        title: "Secure Boot";
                        description: root.secure-boot-status == "Enabled"
                            ? "Firmware verifies every boot image"
                            : (root.secure-boot-status == "Disabled"
                                ? "The system will boot any kernel image"
                                : "State could not be determined");
                        show-chevron: true;
                        hoverable: true;
                        clicked => { root.open-secure-boot-page(); }
                        StatusPill {
                            text: root.secure-boot-status;
                            dot-color: root.secure-boot-status == "Enabled" ? Tokens.success
                                : (root.secure-boot-status == "Disabled" ? Tokens.error : Tokens.on-surface-faint);
                        }
                    }
                    RowSeparator {}
                    SettingRow {
                        icon: @image-url("../../assets/icons/history.svg");
                        icon-color: root.snapshot-count > 0 ? Tokens.accent-info : Tokens.on-surface-faint;
                        title: "Snapshots";
                        description: "Last: " + root.last-snapshot-ts;
                        show-chevron: true;
                        hoverable: true;
                        clicked => { root.open-snapshots-page(); }
                        StatusPill {
                            text: root.snapshot-count + " saved";
                            dot-color: root.snapshot-count > 0 ? Tokens.accent-info : Tokens.on-surface-faint;
                        }
                    }
                }
            }

            // ── Boot configuration ───────────────────────────────────────
            VerticalLayout {
                spacing: Tokens.group-label-gap;
                GroupLabel { text: "Boot configuration"; }
                Group {
                    SettingRow {
                        icon: @image-url("../../assets/icons/star.svg");
                        title: "Default entry";
                        description: "Started automatically when the timeout expires";
                        show-chevron: true;
                        hoverable: true;
                        clicked => { root.open-bootloader-page(); }
                        Text {
                            text: root.grub-default-entry;
                            color: Tokens.on-surface-muted;
                            font-size: Tokens.font-mono-value;
                            font-family: Tokens.font-family-mono;
                            vertical-alignment: center;
                        }
                    }
                    RowSeparator {}
                    SettingRow {
                        icon: @image-url("../../assets/icons/timer.svg");
                        title: "Menu timeout";
                        description: "Time before the default entry starts";
                        show-chevron: true;
                        hoverable: true;
                        clicked => { root.open-bootloader-page(); }
                        Text {
                            text: root.grub-timeout + " s";
                            color: Tokens.on-surface-muted;
                            font-size: Tokens.font-mono-value;
                            font-family: Tokens.font-family-mono;
                            vertical-alignment: center;
                        }
                    }
                    RowSeparator {}
                    SettingRow {
                        icon: @image-url("../../assets/icons/key.svg");
                        title: "MOK keys";
                        description: "Machine Owner Keys enrolled in firmware";
                        show-chevron: true;
                        hoverable: true;
                        clicked => { root.open-secure-boot-page(); }
                        StatusPill {
                            text: root.mok-count + " enrolled";
                            dot-color: root.mok-count > 0 ? Tokens.success : Tokens.on-surface-faint;
                        }
                    }
                }
            }

            // ── Recent activity (spec v1 §3.1 / v2 §10.1 — fix P2-7) ─────
            VerticalLayout {
                spacing: Tokens.group-label-gap;
                HorizontalLayout {
                    alignment: space-between;
                    GroupLabel {
                        text: "Recent activity";
                        vertical-alignment: center;
                    }
                    GhostButton {
                        text: "See all";
                        width: 90px;
                        height: Tokens.button-height-sm;
                        clicked => { root.open-logs-page(); }
                    }
                }
                Group {
                    for row[i] in root.recent-activity : VerticalLayout {
                        if i < 3 : VerticalLayout {
                            if i > 0 : RowSeparator {}
                            SettingRow {
                                icon: row.exit_code == 0
                                    ? @image-url("../../assets/icons/check-circle-fill.svg")
                                    : @image-url("../../assets/icons/error-fill.svg");
                                icon-color: row.exit_code == 0 ? Tokens.success : Tokens.error;
                                title: row.operation + " · " + row.phase;
                                description: row.ts;
                                AuditLogLink {
                                    job-id: row.job_id;
                                    open => { root.open-audit-log(row.job_id); }
                                }
                            }
                        }
                    }
                    if root.recent-activity.length == 0 : SettingRow {
                        icon: @image-url("../../assets/icons/receipt-long.svg");
                        title: "No operations recorded yet";
                        description: "Every write to the boot stack is logged here";
                    }
                }
            }
        }
    }
}
