// crates/gui/ui/pages/settings.slint
//
// User preferences. Stacja (Faza C §3.7): row groups with the current
// value on each row. Interactive controls (preset radios, toggles) are
// engineering-track work (Tor A / spec §10.7) — until they land the page
// shows the real current values and says where they are edited, without
// leaking internal PR numbering into the UI (fix P1-4/B3 wording).

import { Tokens } from "../tokens.slint";
import { Group, GroupLabel, RowSeparator, SettingRow } from "../components/row_group.slint";

export component SettingsPage inherits Rectangle {
    in-out property <string> retention-preset: "default";
    in-out property <bool> auto-dismiss-successes: false;
    in-out property <string> high-contrast-override: "auto";
    in-out property <string> reduced-motion-override: "auto";

    callback save();

    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        spacing: Tokens.group-gap;
        alignment: start;

        VerticalLayout {
            spacing: Tokens.group-label-gap;
            GroupLabel { text: "Snapshots"; }
            Group {
                SettingRow {
                    icon: @image-url("../../assets/icons/history.svg");
                    title: "Retention preset";
                    description: "Conservative 200/90d · Default 50/30d · Aggressive 10/7d";
                    Text {
                        text: root.retention-preset;
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-mono-value;
                        font-family: Tokens.font-family-mono;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Tokens.group-label-gap;
            GroupLabel { text: "Notifications"; }
            Group {
                SettingRow {
                    icon: @image-url("../../assets/icons/notifications.svg");
                    title: "Auto-dismiss success toasts";
                    description: root.auto-dismiss-successes
                        ? "Success messages auto-dismiss after 8 seconds"
                        : "Success messages persist until dismissed (recommended for screen readers)";
                    Text {
                        text: root.auto-dismiss-successes ? "on" : "off";
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-mono-value;
                        font-family: Tokens.font-family-mono;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Tokens.group-label-gap;
            GroupLabel { text: "Accessibility"; }
            Group {
                SettingRow {
                    icon: @image-url("../../assets/icons/contrast.svg");
                    title: "High contrast";
                    description: "\"auto\" follows your desktop session";
                    Text {
                        text: root.high-contrast-override;
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-mono-value;
                        font-family: Tokens.font-family-mono;
                        vertical-alignment: center;
                    }
                }
                RowSeparator {}
                SettingRow {
                    icon: @image-url("../../assets/icons/animation.svg");
                    title: "Reduced motion";
                    description: "\"auto\" follows your desktop session";
                    Text {
                        text: root.reduced-motion-override;
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-mono-value;
                        font-family: Tokens.font-family-mono;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            spacing: Tokens.group-label-gap;
            GroupLabel { text: "Advanced"; }
            Group {
                SettingRow {
                    icon: @image-url("../../assets/icons/folder-open.svg");
                    title: "Settings file";
                    description: "Values above are read from this file; in-app controls are coming with the v2 pages";
                    Text {
                        text: "~/.config/bootcontrol/settings.toml";
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-mono-meta;
                        font-family: Tokens.font-family-mono;
                        vertical-alignment: center;
                    }
                }
                RowSeparator {}
                SettingRow {
                    icon: @image-url("../../assets/icons/policy.svg");
                    title: "Policy file";
                    description: "System-wide policy consulted by the daemon";
                    Text {
                        text: "/etc/bootcontrol/policy.toml";
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-mono-meta;
                        font-family: Tokens.font-family-mono;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
