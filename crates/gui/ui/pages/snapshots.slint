// crates/gui/ui/pages/snapshots.slint
//
// Lists pre-write snapshots. Stacja (Faza C §3.5): one explicit column
// grid (ID mono | reason stretch | actions fixed-right), uppercase column
// header row, every row action on the same vertical axis (fix A4), and an
// explanatory info group. Restore keeps the Confirmation Sheet flow.

import { Tokens } from "../tokens.slint";
import { ScrollView } from "std-widgets.slint";
import { GhostButton } from "../components/ghost_button.slint";
import { DangerButton } from "../components/danger_button.slint";
import { InfoBar } from "../components/info_bar.slint";
import { AuditLogLink } from "../components/audit_log_link.slint";
import { Group, RowSeparator } from "../components/row_group.slint";

export struct SnapshotRow {
    id: string,
    op: string,
    ts: string,
    audit_job_id: string,
}

export component SnapshotsPage inherits Rectangle {
    in property <[SnapshotRow]> snapshots;
    in property <bool> disk-pressure: false;
    in property <string> disk-usage-text: "";
    callback restore-clicked(string);
    callback adjust-retention();
    callback prune-now();
    callback open-recovery-viewer();
    callback open-audit-log(string);

    vertical-stretch: 1;
    background: transparent;

    VerticalLayout {
        spacing: Tokens.space-md;
        alignment: stretch;

        if root.disk-pressure : InfoBar {
            severity: "info";
            message: "Snapshots use " + root.disk-usage-text + ". Adjust retention or prune.";
            dismissible: false;
        }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.snapshots.length + " snapshots"
                        + (root.disk-usage-text != "" ? " · " + root.disk-usage-text : "");
                    color: Tokens.on-surface;
                    font-size: Tokens.font-title-small;
                    font-weight: Tokens.weight-strong;
                }
            }
            HorizontalLayout {
                spacing: Tokens.space-sm;
                GhostButton {
                    text: "Recovery instructions";
                    icon: @image-url("../../assets/icons/menu-book.svg");
                    has-icon: true;
                    width: 210px;
                    clicked => { root.open-recovery-viewer(); }
                }
                GhostButton {
                    text: "Retention…";
                    icon: @image-url("../../assets/icons/tune.svg");
                    has-icon: true;
                    width: 140px;
                    clicked => { root.adjust-retention(); }
                }
            }
        }

        if root.snapshots.length == 0 : Group {
            Rectangle {
                height: 120px;
                VerticalLayout {
                    padding: Tokens.space-lg;
                    alignment: center;
                    Text {
                        text: "No snapshots yet";
                        color: Tokens.on-surface-muted;
                        font-size: Tokens.font-title-small;
                        font-weight: Tokens.weight-strong;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Snapshots are created automatically before any change to your boot configuration.";
                        color: Tokens.on-surface-faint;
                        font-size: Tokens.font-label-large;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if root.snapshots.length > 0 : Group {
            // Column header — same grid as the data rows.
            Rectangle {
                height: Tokens.row-height-compact;
                background: Tokens.surface-container-high;
                HorizontalLayout {
                    padding-left: Tokens.space-lg;
                    padding-right: Tokens.space-lg;
                    spacing: Tokens.col-gap;
                    Text {
                        text: "SNAPSHOT ID";
                        width: Tokens.col-id-width;
                        color: Tokens.on-surface-faint;
                        font-size: Tokens.font-meta;
                        font-weight: Tokens.weight-strong;
                        letter-spacing: Tokens.letter-spacing-label;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "REASON";
                        horizontal-stretch: 1;
                        color: Tokens.on-surface-faint;
                        font-size: Tokens.font-meta;
                        font-weight: Tokens.weight-strong;
                        letter-spacing: Tokens.letter-spacing-label;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "ACTIONS";
                        width: Tokens.col-actions-width + 120px;
                        color: Tokens.on-surface-faint;
                        font-size: Tokens.font-meta;
                        font-weight: Tokens.weight-strong;
                        letter-spacing: Tokens.letter-spacing-label;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        for snap[i] in root.snapshots : VerticalLayout {
                            if i > 0 : RowSeparator {}
                            Rectangle {
                                height: Tokens.row-height-double;
                                HorizontalLayout {
                                    padding-left: Tokens.space-lg;
                                    padding-right: Tokens.space-lg;
                                    spacing: Tokens.col-gap;

                                    VerticalLayout {
                                        alignment: center;
                                        width: Tokens.col-id-width;
                                        Text {
                                            text: snap.id;
                                            color: Tokens.on-surface-muted;
                                            font-size: Tokens.font-mono-meta;
                                            font-family: Tokens.font-family-mono;
                                            overflow: elide;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: snap.op;
                                            color: Tokens.on-surface;
                                            font-size: Tokens.font-title-small;
                                            font-weight: Tokens.weight-medium;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: snap.ts;
                                            color: Tokens.on-surface-dim;
                                            font-size: Tokens.font-label-large;
                                        }
                                    }
                                    // Row actions — all on the same vertical axis (fix A4).
                                    VerticalLayout {
                                        alignment: center;
                                        AuditLogLink {
                                            job-id: snap.audit_job_id;
                                            message-id: "";
                                            label: "Open in Logs";
                                            open => { root.open-audit-log(snap.audit_job_id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        DangerButton {
                                            text: "Restore";
                                            width: 110px;
                                            height: Tokens.button-height-sm;
                                            clicked => { root.restore-clicked(snap.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        InfoBar {
            severity: "info";
            message: "A snapshot is taken automatically before every change to a boot file. Restoring returns the file to its state at that moment.";
        }
    }
}
