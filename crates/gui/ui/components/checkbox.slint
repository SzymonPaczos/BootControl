// crates/gui/ui/components/checkbox.slint
//
// Two-state checkbox with label. Stacja: 18 px square, interactive
// outline, accent fill + check glyph when checked. Centering is
// layout-driven (fix A2).

import { Tokens } from "../tokens.slint";

export component CheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> label;

    height: 28px;

    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checked: root.checked;

    HorizontalLayout {
        spacing: Tokens.space-sm;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: 2px;
                border-color: root.checked ? Tokens.accent : Tokens.border-interactive;
                background: root.checked ? Tokens.accent : transparent;

                animate background, border-color { duration: Tokens.reduced-motion ? 0ms : Tokens.motion-fast; }

                if root.checked : HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/check.svg");
                            width: 14px;
                            height: 14px;
                            colorize: Tokens.on-accent;
                        }
                    }
                }
            }
        }

        Text {
            text: root.label;
            color: Tokens.on-surface;
            font-size: Tokens.font-body-medium;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.checked = !root.checked; }
    }
}
