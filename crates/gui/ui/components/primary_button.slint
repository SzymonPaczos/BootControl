// crates/gui/ui/components/primary_button.slint
//
// Non-destructive primary action button. Stacja: flat accent fill, no
// gradient. Use for: Save, Apply, Continue, Open. Never for destructive
// ops (those go through Confirmation Sheet's destructive primary).
// Anatomy: see docs/GUI_V2_SPEC_v2.md §13 component public APIs.

import { Tokens } from "../tokens.slint";

export component PrimaryButton inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked <=> touch.clicked;

    height: Tokens.button-height-lg;
    border-radius: Tokens.radius-sm;
    background: root.enabled
        ? (touch.pressed
            ? Tokens.accent
            : (touch.has-hover ? Tokens.accent-secondary : Tokens.accent))
        : Tokens.surface-1;
    clip: true;

    animate background { duration: Tokens.reduced-motion ? 0ms : Tokens.motion-fast; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: Tokens.space-lg;
        padding-right: Tokens.space-lg;
        spacing: Tokens.space-sm;
        alignment: center;

        if root.has-icon : Image {
            source: root.icon;
            colorize: root.enabled ? Tokens.on-accent : Tokens.on-surface-disabled;
            width: Tokens.icon-size-sm;
            height: Tokens.icon-size-sm;
        }
        Text {
            text: root.text;
            color: root.enabled ? Tokens.on-accent : Tokens.on-surface-disabled;
            font-size: Tokens.font-body-medium;
            font-weight: Tokens.weight-strong;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
    }
}
