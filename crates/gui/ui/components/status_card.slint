// crates/gui/ui/components/status_card.slint
//
// Status indicator — Stacja restyle (Faza C §2): a tile becomes a ROW:
// icon (20 px) · title 15/500 + description 13 dim · status pill with a
// 7 px semantic dot on the right. Optional micro-meter under the value.
// Public API (label / value / status) unchanged; icon and description
// are additive.

import { Tokens } from "../tokens.slint";
import { StatusPill, MicroMeter } from "row_group.slint";

export component StatusCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> status: "neutral";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> description;
    in property <bool> show-meter: false;
    in property <float> meter-fraction: 0.0;

    property <color> dot-color: root.status == "good" ? Tokens.success
        : (root.status == "bad" ? Tokens.error
        : (root.status == "info" ? Tokens.accent-info
        : Tokens.on-surface-faint));

    accessible-role: text;
    accessible-label: root.label;
    accessible-description: root.label + ": " + root.value
        + (root.status == "good" ? " (good)"
        : (root.status == "bad" ? " (problem)"
        : (root.status == "info" ? " (info)" : "")));

    horizontal-stretch: 1;
    height: Tokens.row-height-double;
    background: transparent;

    HorizontalLayout {
        padding-left: Tokens.space-lg;
        padding-right: Tokens.space-lg;
        spacing: Tokens.col-gap;

        if root.has-icon : VerticalLayout {
            alignment: center;
            width: Tokens.icon-column-width;
            Image {
                source: root.icon;
                width: Tokens.icon-size;
                height: Tokens.icon-size;
                colorize: root.dot-color;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Tokens.on-surface;
                font-size: Tokens.font-title-small;
                font-weight: Tokens.weight-medium;
                overflow: elide;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Tokens.on-surface-dim;
                font-size: Tokens.font-label-large;
                overflow: elide;
            }
            if root.show-meter : Rectangle {
                height: 6px;
                VerticalLayout {
                    alignment: end;
                    MicroMeter {
                        width: 120px;
                        fraction: root.meter-fraction;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            StatusPill {
                text: root.value;
                dot-color: root.dot-color;
            }
        }
    }
}
